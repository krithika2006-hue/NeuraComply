    --path ./fabric/chaincode \
    --lang golang \
    --label neura-audit-cc_1.4

2026-09-24 14:15:01.210 UTC 0001 INFO [cli.lifecycle.chaincode] packageChaincode -> Packaged chaincode into file: neura-audit-cc_1.4.tar.gz (size: 24,180 bytes)

# 2. Install on peer0.org1 (SecOps Node)
$ export CORE_PEER_ADDRESS=localhost:7051
$ export CORE_PEER_LOCALMSPID="Org1MSP"
$ export CORE_PEER_MSPCONFIGPATH=/etc/hyperledger/fabric/msp/users/Admin@org1.neuracomply.internal/msp

$ peer lifecycle chaincode install neura-audit-cc_1.4.tar.gz
2026-09-24 14:15:15.340 UTC 0001 INFO [cli.lifecycle.chaincode] runInstall -> Installed with package ID 'neura-audit-cc_1.4:7a8b9c24ef8192a01948571029384bcde918237465192837465109283746152a'

# 3. Install on peer0.auditor (Regulatory CERT-In Node)
$ export CORE_PEER_ADDRESS=localhost:9051
$ export CORE_PEER_LOCALMSPID="AuditorMSP"
$ export CORE_PEER_MSPCONFIGPATH=/etc/hyperledger/fabric/msp/users/Admin@auditor.neuracomply.internal/msp

$ peer lifecycle chaincode install neura-audit-cc_1.4.tar.gz
2026-09-24 14:15:28.710 UTC 0001 INFO [cli.lifecycle.chaincode] runInstall -> Installed with package ID 'neura-audit-cc_1.4:7a8b9c24ef8192a01948571029384bcde918237465192837465109283746152a'

# 4. Approve for Org1MSP
$ export CC_PACKAGE_ID="neura-audit-cc_1.4:7a8b9c24ef8192a01948571029384bcde918237465192837465109283746152a"
$ export ORDERER_CA=/etc/hyperledger/fabric/orderer/tls/ca.crt

$ peer lifecycle chaincode approveformyorg \
    -o localhost:7050 \
    --ordererTLSHostnameOverride orderer.neuracomply.internal \
    --channelID neura-compliance-channel \
    --name neura-audit-cc \
    --version 1.4 \
    --package-id $CC_PACKAGE_ID \
    --sequence 1 \
    --signature-policy "AND('Org1MSP.peer', 'AuditorMSP.peer')" \
    --tls --cafile $ORDERER_CA

